[Unit]
Description=MemOS LOCOMO OpenClaw versioned evaluation (npm watch + run)
After=network-online.target

[Service]
Type=oneshot
User=CHANGE_ME
Environment=MEMOS_EVAL_ROOT=/opt/MemOS/evaluation
Environment=MEMOS_LOCOMO_STATE_DIR=/var/lib/memos-locomo-eval
# Optional:
# Environment=MEMOS_LOCOMO_VENV=/opt/venvs/memos-eval
# Environment=NPM_CONFIG_REGISTRY=https://registry.npmjs.org
ExecStart=/opt/MemOS/evaluation/scripts/automation/locomo_openclaw_versioned_eval.sh

[Install]
WantedBy=multi-user.target
